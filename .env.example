# Application
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000

# Database
DATABASE_URL=postgresql://signalforge:signalforge@localhost:5435/signalforge?schema=public

# Redis
# If using docker-compose, Redis requires a password (default: signalforge-redis).
REDIS_URL=redis://:signalforge-redis@localhost:6380
# REDIS_PASSWORD=signalforge-redis

# Security
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-or-hex-key

# AI Provider (mock | openai)
# Default: mock — no API key needed, returns deterministic dev data.
# For FreeLLMAPI:  AI_PROVIDER=openai, OPENAI_BASE_URL=http://localhost:3001/v1
#                  OPENAI_API_KEY=<your FreeLLMAPI unified key>
#                  OPENAI_MODEL=auto (or auto:smart, auto:fast, auto:cheap)
# For OpenAI:     AI_PROVIDER=openai, OPENAI_API_KEY=sk-...
# For OpenRouter: AI_PROVIDER=openai, OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                 OPENAI_MODEL=openai/gpt-4o
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# OAuth (future)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Lead Discovery (Module 16)
# Sources are optional — CSV/XLSX import works with none of these set.
# LEAD_DISCOVERY_MODE=mock
# GOOGLE_MAPS_API_KEY=
# MAX_DISCOVERY_RESULTS=500
# MAX_EMAIL_VERIFY_CONCURRENCY=5

# Lead Research (Module 17) — LinkedIn research is OFF by default.
# Only researcher-provided URLs are ever looked at; no crawling, no LinkedIn automation.
# Never put LinkedIn passwords, cookies or session tokens in this file or in the database.
LINKEDIN_RESEARCH_ENABLED=false
# LINKEDIN_RESEARCH_PROVIDER=public             # manual | public | agent-reach
# LINKEDIN_RESEARCH_PUBLIC_FETCH_ENABLED=true   # one Jina Reader fetch of the pasted public URL
# LINKEDIN_RESEARCH_AGENT_REACH_MCP_ENABLED=false
# LINKEDIN_RESEARCH_MAX_CONCURRENCY=1
# LINKEDIN_RESEARCH_TIMEOUT_MS=20000
# LINKEDIN_RESEARCH_MAX_ATTEMPTS=2
# LINKEDIN_RESEARCH_MAX_BATCH_SIZE=50
# AGENT_REACH_BIN=agent-reach                   # or the full path to the agent-reach executable
# AGENT_REACH_HEALTH_TIMEOUT_MS=15000
# JINA_READER_BASE_URL=https://r.jina.ai
# JINA_API_KEY=

# Lead Discovery — Google Maps Scraper (self-hosted, no API key needed)
# Requires the gosom/google-maps-scraper Docker container:
#   docker compose --profile scraper up -d
# GOOGLE_MAPS_SCRAPER_ENABLED=false
# GOOGLE_MAPS_SCRAPER_URL=http://localhost:8080
# GOOGLE_MAPS_SCRAPER_MAX_TIME=120
# GOOGLE_MAPS_SCRAPER_DEPTH=1
# GOOGLE_MAPS_SCRAPER_POLL_INTERVAL_MS=3000
# GOOGLE_MAPS_SCRAPER_MAX_POLL_ATTEMPTS=120

# Email Discovery (Stage 5) — discovers emails for leads without one
# Reuses the website-scanner crawler; no new infrastructure needed.
# EMAIL_DISCOVERY_ENABLED=true
# EMAIL_DISCOVERY_MAX_CONCURRENCY=3
# EMAIL_DISCOVERY_MAX_PAGES=3
# EMAIL_DISCOVERY_TIMEOUT_MS=10000
# EMAIL_DISCOVERY_PATTERN_INFERENCE=false

# System Email (transactional: password resets, email verification)
# Optional — if not set, reset/verification emails are logged but not sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=noreply@localhost
# SMTP_FROM_NAME=SignalForge

# Performance / Tuning (Stage 18)
PG_POOL_MAX=25
RATE_LIMIT_MAX=200

# Frontend (browser-facing API URL, baked into Next.js client bundle)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Lead Qualification (Stage 6)
# Qualification config lives in each workspace's ICPProfile (weights,
# thresholds, requireVerifiedEmail). This optional global minimum score
# override applies when no per-job minScore is specified.
# QUALIFICATION_MIN_SCORE=0
