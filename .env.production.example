# ─── SignalForge Production Environment ──────────────────────────────────────
# Copy to .env.production and fill in all <CHANGE_ME> values before deployment.
# Generate secrets: openssl rand -base64 48

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=warn
APP_URL=https://yourdomain.com
API_URL=http://api:4000
WEB_PORT=3000
API_PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
# Internal Docker network hostname. Change password before first deployment.
DATABASE_URL=postgresql://signalforge:<CHANGE_ME>@postgres:5432/signalforge?schema=public
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=signalforge

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<CHANGE_ME>@redis:6379
REDIS_PASSWORD=<CHANGE_ME>

# ─── Security (generate with: openssl rand -base64 48) ──────────────────────
SESSION_SECRET=<CHANGE_ME_MIN_32_CHARS>
ENCRYPTION_KEY=<CHANGE_ME_MIN_32_CHARS>

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Default: mock (no external calls). For production AI:
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:3001/v1  (FreeLLMAPI)
#   OPENAI_API_KEY=<your-key>
#   OPENAI_MODEL=auto
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ─── OAuth (optional) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Email Verification ─────────────────────────────────────────────────────
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_SMTP_ENABLED=true
EMAIL_VERIFICATION_CACHE_TTL_DAYS=7
EMAIL_VERIFICATION_SMTP_TIMEOUT_MS=10000
EMAIL_VERIFICATION_SMTP_MAX_RETRIES=2
EMAIL_VERIFICATION_MAX_CONCURRENCY=10
EMAIL_VERIFICATION_PER_DOMAIN_LIMIT=5
EMAIL_VERIFICATION_MAX_BULK_SIZE=10000

# ─── Lead Research (off by default) ─────────────────────────────────────────
LINKEDIN_RESEARCH_ENABLED=false
# LINKEDIN_RESEARCH_PROVIDER=public
# LINKEDIN_RESEARCH_PUBLIC_FETCH_ENABLED=true
# LINKEDIN_RESEARCH_AGENT_REACH_MCP_ENABLED=false
# LINKEDIN_RESEARCH_MAX_CONCURRENCY=1
# LINKEDIN_RESEARCH_TIMEOUT_MS=20000
# LINKEDIN_RESEARCH_MAX_ATTEMPTS=2
# LINKEDIN_RESEARCH_MAX_BATCH_SIZE=50
# AGENT_REACH_BIN=agent-reach
# AGENT_REACH_HEALTH_TIMEOUT_MS=15000
# JINA_READER_BASE_URL=https://r.jina.ai
# JINA_API_KEY=

# ─── Web Research (off by default) ──────────────────────────────────────────
WEB_RESEARCH_ENABLED=false
# WEB_RESEARCH_TIMEOUT_MS=30000
# WEB_RESEARCH_MAX_PAGES=5
# WEB_RESEARCH_AI_INTERPRETATION_ENABLED=false

# ─── Lead Discovery — Google Maps Scraper ────────────────────────────────────
# Requires the scraper profile: docker compose --profile scraper up -d
GOOGLE_MAPS_SCRAPER_ENABLED=false
# GOOGLE_MAPS_SCRAPER_URL=http://google-maps-scraper:8080
# GOOGLE_MAPS_SCRAPER_MAX_TIME=120
# GOOGLE_MAPS_SCRAPER_DEPTH=1

# ─── Email Discovery ────────────────────────────────────────────────────────
EMAIL_DISCOVERY_ENABLED=true
# EMAIL_DISCOVERY_MAX_CONCURRENCY=3
# EMAIL_DISCOVERY_MAX_PAGES=3
# EMAIL_DISCOVERY_TIMEOUT_MS=10000
# EMAIL_DISCOVERY_PATTERN_INFERENCE=false

# ─── System Email (transactional: password resets, email verification) ──────
# Optional. If not set, reset/verification emails are logged but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=SignalForge

# ─── Performance / Tuning ───────────────────────────────────────────────────
PG_POOL_MAX=25
RATE_LIMIT_MAX=200

# ─── Frontend (build-time, baked into client bundle) ─────────────────────────
# For Vercel deployment: NEXT_PUBLIC_API_URL should be /api (same-origin proxy).
# Vercel's Next.js rewrites proxy /api/* to the API_URL server-side env var.
NEXT_PUBLIC_API_URL=/api

# ─── Deployment Notes ───────────────────────────────────────────────────────
# Frontend on Vercel:
#   - Set API_URL as a server-side env var pointing to your VPS API
#     (e.g. https://api.yourdomain.com)
#   - Set NEXT_PUBLIC_API_URL=/api (uses Next.js rewrites for same-origin proxy)
#   - APP_URL should match your Vercel domain (e.g. https://yourdomain.com)
#
# Backend on VPS:
#   - API_URL=http://api:4000 (internal Docker network)
#   - APP_URL=https://yourdomain.com (your Vercel frontend URL, for CORS)
