{
  "name": "signalforge",
  "version": "0.0.1",
  "private": true,
  "description": "SignalForge - AI Outbound Sales and Intelligence Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @signalforge/database db:generate",
    "db:migrate": "pnpm --filter @signalforge/database db:migrate",
    "db:seed": "pnpm --filter @signalforge/database db:seed",
    "db:push": "pnpm --filter @signalforge/database db:push"
  },
  "devDependencies": {
    "@signalforge/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.12.0"
  }
}
