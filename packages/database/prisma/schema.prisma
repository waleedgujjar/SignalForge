// ─── Deliverability & Email Health (Module 13) ────────────────────────────────

enum BounceType {
  HARD
  SOFT
}

enum DeliveryEventType {
  SENT
  DELIVERED
  BOUNCED
  FAILED
  COMPLAINT
  UNSUBSCRIBE
  REPLY
}

enum DeliveryEventSource {
  SENDING
  INBOX
  SYSTEM
}

enum DeliverabilityProtectionLevel {
  NORMAL
  WARNING
  AT_RISK
  CRITICAL
}

enum RecipientBounceStatus {
  ACTIVE
  AT_RISK
  SUPPRESSED
}

enum DnsCheckStatus {
  PASS
  FAIL
  INVALID
  UNKNOWN
  NOT_CHECKED
}

enum DeliverabilityAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DeliverabilityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DeliverabilityAlertType {
  ELEVATED_BOUNCE_RATE
  ELEVATED_FAILURE_RATE
  ELEVATED_UNSUBSCRIBE_RATE
  MAILBOX_HEALTH_DROP
  MAILBOX_HEALTH_IMPROVED
  HARD_BOUNCE_DETECTED
  MAILBOX_PAUSED
  DOMAIN_AUTH_ISSUE
  SENDING_VELOCITY_ANOMALY
}

enum DeliverabilityEntityType {
  WORKSPACE
  MAILBOX
  CAMPAIGN
  DOMAIN
}

/// Append-only delivery signal log. `idempotencyKey` guarantees that replayed
/// worker jobs never inflate aggregated metrics.
model EmailDeliveryEvent {
  id                 String              @id @default(cuid())
  workspaceId        String
  idempotencyKey     String
  emailMessageId     String?
  sendingJobId       String?
  mailboxId          String?
  leadId             String?
  campaignId         String?
  eventType          DeliveryEventType
  bounceType         BounceType?
  smtpStatusCode     String?
  enhancedStatusCode String?
  providerResponse   String?
  source             DeliveryEventSource @default(SENDING)
  occurredAt         DateTime            @default(now())
  metadata           Json                @default("{}")
  createdAt          DateTime            @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  mailbox      Mailbox?      @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, mailboxId, occurredAt])
  @@index([workspaceId, campaignId, eventType, occurredAt])
  @@index([workspaceId, eventType, occurredAt])
  @@index([workspaceId, leadId])
}

/// Per-recipient bounce history. Hard bounces suppress immediately via the
/// existing Suppression table; this tracks repeated soft failures.
model RecipientBounceState {
  id             String                @id @default(cuid())
  workspaceId    String
  email          String
  lastBounceType BounceType?
  bounceCount    Int                   @default(0)
  softBounceCount Int                  @default(0)
  hardBounceCount Int                  @default(0)
  status         RecipientBounceStatus @default(ACTIVE)
  lastSmtpCode   String?
  lastResponse   String?
  firstBounceAt  DateTime              @default(now())
  lastBounceAt   DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model MailboxHealthSnapshot {
  id                String                        @id @default(cuid())
  workspaceId       String
  mailboxId         String
  snapshotDate      DateTime                      @db.Date
  sent              Int                           @default(0)
  delivered         Int                           @default(0)
  bounced           Int                           @default(0)
  hardBounces       Int                           @default(0)
  softBounces       Int                           @default(0)
  failed            Int                           @default(0)
  replies           Int                           @default(0)
  unsubscribes      Int                           @default(0)
  complaints        Int                           @default(0)
  bounceRate        Float                         @default(0)
  failureRate       Float                         @default(0)
  replyRate         Float                         @default(0)
  unsubscribeRate   Float                         @default(0)
  healthScore       Int                           @default(100)
  protectionLevel   DeliverabilityProtectionLevel @default(NORMAL)
  scoreBreakdown    Json                          @default("{}")
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, snapshotDate])
  @@index([workspaceId, snapshotDate])
  @@index([workspaceId, healthScore])
}

model CampaignHealthSnapshot {
  id              String   @id @default(cuid())
  workspaceId     String
  campaignId      String
  snapshotDate    DateTime @db.Date
  sent            Int      @default(0)
  delivered       Int      @default(0)
  bounced         Int      @default(0)
  hardBounces     Int      @default(0)
  softBounces     Int      @default(0)
  failed          Int      @default(0)
  replies         Int      @default(0)
  unsubscribes    Int      @default(0)
  complaints      Int      @default(0)
  bounceRate      Float    @default(0)
  failureRate     Float    @default(0)
  replyRate       Float    @default(0)
  unsubscribeRate Float    @default(0)
  healthScore     Int      @default(100)
  scoreBreakdown  Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, snapshotDate])
  @@index([workspaceId, snapshotDate])
  @@index([workspaceId, healthScore])
}

/// Cached SPF/DKIM/DMARC/MX lookups. Results are served from cache until
/// `expiresAt`; UNKNOWN is never coerced to PASS.
model DomainHealthCheck {
  id            String         @id @default(cuid())
  workspaceId   String
  domain        String
  spfStatus     DnsCheckStatus @default(NOT_CHECKED)
  dkimStatus    DnsCheckStatus @default(NOT_CHECKED)
  dmarcStatus   DnsCheckStatus @default(NOT_CHECKED)
  mxStatus      DnsCheckStatus @default(NOT_CHECKED)
  spfRecord     String?
  dmarcPolicy   String?
  dkimSelectors Json           @default("[]")
  rawResults    Json           @default("{}")
  lastError     String?
  checkedAt     DateTime       @default(now())
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([workspaceId, expiresAt])
}

/// Deduplicated by `dedupeKey` (type:entity:window) so a persistent issue
/// produces one open alert rather than one per evaluation tick.
model DeliverabilityAlert {
  id             String                      @id @default(cuid())
  workspaceId    String
  severity       DeliverabilityAlertSeverity
  alertType      DeliverabilityAlertType
  entityType     DeliverabilityEntityType
  entityId       String?
  entityLabel    String?
  title          String
  message        String
  recommendation String?
  dedupeKey      String
  status         DeliverabilityAlertStatus   @default(OPEN)
  metadata       Json                        @default("{}")
  occurredAt     DateTime                    @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, occurredAt])
  @@index([workspaceId, severity, occurredAt])
  @@index([workspaceId, entityType, entityId])
}

model WorkspaceDeliverabilityPolicy {
  workspaceId String   @id
  protection  Json     @default("{}")
  thresholds  Json     @default("{}")
  weights     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── Module 14: Analytics & Reporting ────────────────────────────────────────

enum LeadOutcomeType {
  MEETING_BOOKED
  QUALIFIED
  CONVERTED
}

enum LeadOutcomeSource {
  MANUAL
  API
  SYSTEM
}

/// Records real business outcomes for a lead. The analytics funnel counts
/// meetings and conversions from this table only, so a stage is never inferred
/// from reply sentiment or any other proxy signal.
model LeadOutcomeEvent {
  id             String            @id @default(cuid())
  workspaceId    String
  leadId         String
  campaignId     String?
  conversationId String?
  type           LeadOutcomeType
  source         LeadOutcomeSource @default(MANUAL)
  /// When the outcome happened in the real world.
  occurredAt     DateTime          @default(now())
  /// When it was logged in SignalForge; the two differ for backdated entries.
  recordedAt     DateTime          @default(now())
  recordedById   String?
  note           String?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, type, occurredAt])
  @@index([workspaceId, campaignId, type, occurredAt])
  @@index([leadId])
}

/// Daily workspace rollup backing the analytics overview and trend charts.
/// Warmup counters are kept in their own fields so they can never be mixed
/// into campaign performance numbers.
model WorkspaceAnalyticsSnapshot {
  id           String   @id @default(cuid())
  workspaceId  String
  snapshotDate DateTime @db.Date

  leadsCreated    Int @default(0)
  leadsVerified   Int @default(0)
  leadsQualified  Int @default(0)
  leadsContacted  Int @default(0)
  leadsReplied    Int @default(0)
  positiveReplies Int @default(0)
  meetingsBooked  Int @default(0)
  conversions     Int @default(0)

  sent         Int @default(0)
  delivered    Int @default(0)
  bounced      Int @default(0)
  hardBounces  Int @default(0)
  softBounces  Int @default(0)
  failed       Int @default(0)
  replies      Int @default(0)
  unsubscribes Int @default(0)
  complaints   Int @default(0)

  verifiedCount Int @default(0)
  invalidCount  Int @default(0)
  riskyCount    Int @default(0)
  unknownCount  Int @default(0)

  warmupSent   Int @default(0)
  warmupFailed Int @default(0)

  /// Reply counts keyed by ReplyClassification, e.g. { "INTERESTED": 4 }.
  replyBreakdown Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, snapshotDate])
  @@index([workspaceId, snapshotDate])
}

