// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id                        String                    @id @default(cuid())
  workspaceId               String
  name                      String
  description               String?
  status                    CampaignStatus            @default(DRAFT)
  rotationStrategy          RotationStrategy          @default(HEALTH_AWARE)
  sendingMode               CampaignSendingMode       @default(MAILBOX_LIST)
  smtpPoolId                String?
  mailboxId                 String?
  dailySendingLimit         Int?
  scheduleConfig            Json                      @default("{}")
  verificationPolicy        Json                      @default("{}")
  suppressionPolicy         Json                      @default("{}")
  duplicateEnrollmentPolicy DuplicateEnrollmentPolicy @default(BLOCK)
  replyHandlingPolicy       Json                      @default("{\"pauseOnReply\":false,\"stopOnReply\":true,\"autoArchiveOoo\":false,\"detectUnsubscribe\":true}")
  followUpsEnabled          Boolean                   @default(false)
  maxFollowUps              Int                       @default(5)
  pausedAt                  DateTime?
  launchedAt                DateTime?
  scheduledAt               DateTime?
  stoppedAt                 DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  archivedAt                DateTime?

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps             CampaignStep[]
  campaignLeads     CampaignLead[]
  mailboxes         CampaignMailbox[]
  emailMessages     EmailMessage[]
  activities        CampaignActivity[]
  sendingJobs       SendingJob[]
  dailyUsage        CampaignDailyUsage[]
  smtpPool          SmtpPool?                  @relation(fields: [smtpPoolId], references: [id], onDelete: SetNull)
  singleMailbox     Mailbox?                   @relation("CampaignSingleMailbox", fields: [mailboxId], references: [id], onDelete: SetNull)
  allocationHistory MailboxAllocationHistory[]
  conversations     Conversation[]
  deliveryEvents    EmailDeliveryEvent[]
  healthSnapshots   CampaignHealthSnapshot[]
  outcomeEvents     LeadOutcomeEvent[]

  @@index([workspaceId, status, createdAt])
  @@index([smtpPoolId])
}

enum CampaignSendingMode {
  MAILBOX_LIST
  SMTP_POOL
  SINGLE_MAILBOX
}

model CampaignStep {
  id              String    @id @default(cuid())
  campaignId      String
  order           Int
  type            StepType  @default(EMAIL)
  delayDays       Int       @default(0)
  delayAmount     Int       @default(0)
  delayUnit       DelayUnit @default(DAYS)
  subjectTemplate String
  bodyTemplate    String
  enabled         Boolean   @default(true)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sendingJobs SendingJob[]

  @@unique([campaignId, order])
  @@index([campaignId, order])
}

model CampaignActivity {
  id          String               @id @default(cuid())
  campaignId  String
  workspaceId String
  actorUserId String?
  type        CampaignActivityType
  summary     String
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([workspaceId, createdAt])
}

model CampaignLead {
  id               String                  @id @default(cuid())
  campaignId       String
  leadId           String
  currentStepOrder Int                     @default(0)
  status           CampaignLeadStatus      @default(PENDING)
  stopReason       CampaignLeadStopReason?
  stoppedAt        DateTime?
  enrolledAt       DateTime                @default(now())
  completedAt      DateTime?
  pausedAt         DateTime?
  repliedAt        DateTime?
  lastReplyAt      DateTime?
  subjectOverride  String?
  bodyOverride     String?

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sendingJobs   SendingJob[]
  conversations Conversation[]

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([campaignId, repliedAt])
  @@index([leadId])
}

model CampaignMailbox {
  id         String @id @default(cuid())
  campaignId String
  mailboxId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mailbox  Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([campaignId, mailboxId])
}

model SendingPolicy {
  id                    String                @id @default(cuid())
  workspaceId           String                @unique
  rotationStrategy      RotationStrategy      @default(ROUND_ROBIN)
  enabled               Boolean               @default(true)
  degradedMailboxPolicy DegradedMailboxPolicy @default(ALLOW)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum DegradedMailboxPolicy {
