generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Tenancy ───────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  name                  String?
  firstName             String?
  lastName              String?
  avatarUrl             String?
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships             WorkspaceMember[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  timezone        String   @default("UTC")
  defaultFromName String?
  defaultReplyTo  String?
  onboardingMeta  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members            WorkspaceMember[]
  activeSessions     Session[]                    @relation("ActiveWorkspace")
  mailboxes          Mailbox[]
  leads              Lead[]
  campaigns          Campaign[]
  suppressions       Suppression[]
  customFields       CustomField[]
  sendingPolicies    SendingPolicy[]
  verificationPolicy WorkspaceVerificationPolicy?
  tags               Tag[]
  leadLists          LeadList[]
  integrations       IntegrationAccount[]
  leadImports        LeadImport[]
  stagingDatasets    StagingDataset[]
  stagedLeads        StagedLead[]
  websiteAnalyses    WebsiteAnalysis[]
  icpProfile         ICPProfile?
  leadEnrichments    LeadEnrichment[]
  serviceCatalog     ServiceCatalogEntry[]
  smtpPools          SmtpPool[]
  reservations       MailboxCapacityReservation[]
  allocationHistory  MailboxAllocationHistory[]
  warmupConfigs      EmailWarmupConfig[]
  warmupRecipients   WarmupRecipient[]
  warmupJobs         WarmupJob[]
  warmupHistory      WarmupDailyHistory[]
  warmupReservations WarmupCapacityReservation[]
  conversations      Conversation[]
  conversationNotes  ConversationNote[]
  conversationActivities ConversationActivity[]
  inboxSyncJobs      InboxSyncJob[]
  deliveryEvents         EmailDeliveryEvent[]
  recipientBounceStates  RecipientBounceState[]
  mailboxHealthSnapshots MailboxHealthSnapshot[]
  campaignHealthSnapshots CampaignHealthSnapshot[]
  domainHealthChecks     DomainHealthCheck[]
  deliverabilityAlerts   DeliverabilityAlert[]
  deliverabilityPolicy   WorkspaceDeliverabilityPolicy?
  leadOutcomeEvents      LeadOutcomeEvent[]
  analyticsSnapshots     WorkspaceAnalyticsSnapshot[]
  workflows              Workflow[]
  workflowEvents         WorkflowEvent[]
  workflowActivities     WorkflowActivity[]
  notifications          Notification[]
  discoveryJobs          LeadDiscoveryJob[]
  discoveredLeads        DiscoveredLead[]
  leadSourceRecords      LeadSourceRecord[]
  discoveryActivities    LeadDiscoveryActivity[]
  leadSourceConfigs      LeadSourceConfig[]
  emailVerificationJobs  EmailVerificationJob[]
  emailVerificationHistory EmailVerificationHistory[]
  domainVerificationCache DomainVerificationCache[]
  scrapeGraphJobs        ScrapeGraphJob[]
  scrapeGraphScripts     ScrapeGraphScript[]
  aiUsageRecords         AiUsageRecord[]
  leadResearch           LeadResearch[]
  leadResearchActivities LeadResearchActivity[]
  researchProviderConfigs ResearchProviderConfig[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  tokenHash         String   @unique
  activeWorkspaceId String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId])
  @@index([activeWorkspaceId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─── Mailboxes ────────────────────────────────────────────────────────────────

model Mailbox {
  id                   String          @id @default(cuid())
  workspaceId          String
  provider             MailboxProvider @default(SMTP)
  name                 String?
  emailAddress         String
  fromName             String
  replyTo              String?
  smtpHost             String?
  smtpPort             Int?
  smtpUsername         String?
  encryptionType       SmtpEncryption  @default(TLS)
  status               MailboxStatus   @default(UNVERIFIED)
  dailySendingLimit    Int             @default(100)
  currentDailyUsage    Int             @default(0)
  usageResetAt         DateTime        @default(now())
  timezone             String?
  healthStatus         HealthStatus    @default(UNKNOWN)
  warmupStatus         WarmupStatus    @default(NOT_STARTED)
  lastTestedAt         DateTime?
  verifiedAt           DateTime?
  lastSuccessfulSendAt DateTime?
  lastErrorAt          DateTime?
  lastErrorMessage     String?
  inboundEnabled       Boolean         @default(false)
  inboundStatus        InboundSyncStatus @default(DISABLED)
  lastInboundSyncAt    DateTime?
  lastInboundError     String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential         MailboxCredential?
  health             MailboxHealth?
  campaigns          CampaignMailbox[]
  emailMessages      EmailMessage[]
  connectionTests    MailboxConnectionTest[]
  activities         MailboxActivity[]
  dailyUsage         MailboxDailyUsage[]
  sendingJobs        SendingJob[]
  poolMemberships    SmtpPoolAccount[]
  singleCampaigns    Campaign[]                   @relation("CampaignSingleMailbox")
  reservations       MailboxCapacityReservation[]
  allocationHistory  MailboxAllocationHistory[]
  warmupConfig       EmailWarmupConfig?
  warmupJobs         WarmupJob[]
  warmupHistory      WarmupDailyHistory[]
  warmupReservations WarmupCapacityReservation[]
  inboundConfig      MailboxInboundConfig?
  syncState          MailboxSyncState?
  conversations      Conversation[]
  conversationMessages ConversationMessage[]
  inboxSyncJobs      InboxSyncJob[]
  deliveryEvents     EmailDeliveryEvent[]
  healthSnapshots    MailboxHealthSnapshot[]

  @@unique([workspaceId, emailAddress])
  @@index([workspaceId, status])
  @@index([workspaceId, inboundEnabled, inboundStatus])
}

model MailboxCredential {
  id               String   @id @default(cuid())
  mailboxId        String   @unique
  encryptedPayload String
  keyVersion       Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
}

model MailboxHealth {
  id                  String                        @id @default(cuid())
  mailboxId           String                        @unique
  score               Int                           @default(100)
  failureCount        Int                           @default(0)
  consecutiveFailures Int                           @default(0)
  hardBounceCount     Int                           @default(0)
  softBounceCount     Int                           @default(0)
  protectionLevel     DeliverabilityProtectionLevel @default(NORMAL)
  protectionReason    String?
  protectionUpdatedAt DateTime?
  scoreBreakdown      Json                          @default("{}")
  lastCheckedAt       DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
}

model MailboxConnectionTest {
  id            String                      @id @default(cuid())
  mailboxId     String
  workspaceId   String
  status        MailboxConnectionTestStatus
  errorCategory SmtpErrorCategory?
  summary       String
  metadata      Json                        @default("{}")
  createdAt     DateTime                    @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId, createdAt])
  @@index([workspaceId, createdAt])
}

model MailboxActivity {
  id          String              @id @default(cuid())
  mailboxId   String
  workspaceId String
  actorUserId String?
  type        MailboxActivityType
  summary     String
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([mailboxId, createdAt])
  @@index([workspaceId, createdAt])
}

model MailboxDailyUsage {
  id                  String   @id @default(cuid())
  mailboxId           String
  usageDate           DateTime @db.Date
  sentCount           Int      @default(0)
  reservedCount       Int      @default(0)
  warmupSentCount     Int      @default(0)
  warmupReservedCount Int      @default(0)
  updatedAt           DateTime @updatedAt

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, usageDate])
  @@index([mailboxId, usageDate])
}

enum MailboxProvider {
  SMTP
  GOOGLE_OAUTH
  MICROSOFT_OAUTH
}

enum SmtpEncryption {
  NONE
  TLS
  SSL
}

enum MailboxStatus {
  UNVERIFIED
  ACTIVE
  DISABLED
  PAUSED
  ERROR
  DISCONNECTED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

enum MailboxConnectionTestStatus {
  SUCCESS
  FAILED
}

enum SmtpErrorCategory {
  AUTH_FAILED
  CONNECTION_REFUSED
  CONNECTION_TIMEOUT
  INVALID_HOST
  INVALID_PORT
  TLS_FAILED
  PROVIDER_REJECTED
  UNKNOWN
}

enum MailboxActivityType {
  CREATED
  UPDATED
  TESTED
  VERIFIED
  ENABLED
  DISABLED
  DELETED
  PASSWORD_UPDATED
  PROTECTION_PAUSED
  PROTECTION_RESUMED
}

enum WarmupStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  BLOCKED
  DISABLED
}

enum WarmupJobStatus {
  QUEUED
  DISPATCHED
  IN_PROGRESS
  SENT
  DEFERRED
  FAILED
  CANCELLED
  PAUSED
}

enum WarmupReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id            String     @id @default(cuid())
  workspaceId   String
  email         String
  firstName     String?
  lastName      String?
  fullName      String?
  company       String?
  companyDomain String?
  jobTitle      String?
  industry      String?
  phone         String?
  linkedinUrl   String?
  countryCode   String?
  country       String?
  region        String?
  state         String?
  city          String?
  website       String?
  icpScore      Int?
  status        LeadStatus @default(NEW)
  source        LeadSource @default(MANUAL)
  customFields  Json       @default("{}")
  importId      String?
  sourceFileId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  verification    LeadVerification?
  campaignLeads   CampaignLead[]
  tags            LeadTag[]
  listMembers     LeadListMember[]
  notes           LeadNote[]
  websiteAnalyses WebsiteAnalysis[]
  scrapeGraphJobs ScrapeGraphJob[]
  enrichment      LeadEnrichment?
  sendingJobs     SendingJob[]
  conversations   Conversation[]
  outcomeEvents       LeadOutcomeEvent[]
  workflowExecutions  WorkflowExecution[]
  sourceRecords       LeadSourceRecord[]
  discoveredFrom      DiscoveredLead[]
  research            LeadResearch[]
  researchActivities  LeadResearchActivity[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  // Domain-keyed deduplication scans this on every discovered lead; without it
  // the dedup engine degrades to a sequential scan of the whole workspace.
  @@index([workspaceId, companyDomain])
  @@index([workspaceId, countryCode])
  @@index([workspaceId, countryCode, state])
  @@index([workspaceId, countryCode, state, city])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, importId])
  @@index([workspaceId, industry])
  @@index([workspaceId, jobTitle])
  @@index([workspaceId, status, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  UNSUBSCRIBED
  BOUNCED
  ARCHIVED
}

enum LeadSource {
  MANUAL
  CSV_IMPORT
  GOOGLE_DRIVE
  DISCOVERY
  API
  OTHER
}

model LeadVerification {
  id                  String             @id @default(cuid())
  leadId              String             @unique
  workspaceId         String?
  email               String
  originalEmail       String?
  normalizedEmail     String?
  status              VerificationStatus @default(UNKNOWN)
  score               Int                @default(0)
  riskScore           Int?
  riskLevel           RiskLevel?
  confidenceScore     Int?
  reason              String?
  reasonCode          String?
  domain              String?
  mxStatus            String?
  syntaxValid         Boolean?
  domainValid         Boolean?
  dnsResolved         Boolean?
  mxFound             Boolean?
  mxRecords           Json?
  smtpStatus          String?
  isDisposable        Boolean            @default(false)
  isRole              Boolean            @default(false)
  roleType            String?
  isCatchAll          Boolean            @default(false)
  providerType        ProviderType?
  verificationMethod  String?
  riskFactors         Json?
  verificationVersion String             @default("v1")
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, status])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum ProviderType {
  FREE
  BUSINESS
  UNKNOWN
}

enum EmailVerificationJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum EmailVerificationJobSource {
  LEADS
  EXCEL
  PASTE
  DISCOVERY
  SINGLE
}

model EmailVerificationJob {
  id                String                     @id @default(cuid())
  workspaceId       String
  initiatedByUserId String?
  status            EmailVerificationJobStatus @default(PENDING)
  source            EmailVerificationJobSource @default(PASTE)
  name              String?
  total             Int                        @default(0)
  pending           Int                        @default(0)
  processing        Int                        @default(0)
  completed         Int                        @default(0)
  validCount        Int                        @default(0)
  invalidCount      Int                        @default(0)
  riskyCount        Int                        @default(0)
  unknownCount      Int                        @default(0)
  disposableCount   Int                        @default(0)
  roleCount         Int                        @default(0)
  failedCount       Int                        @default(0)
  error             String?
  metadata          Json                       @default("{}")
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  history   EmailVerificationHistory[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model EmailVerificationHistory {
  id                 String             @id @default(cuid())
  workspaceId        String
  jobId              String?
  leadId             String?
  email              String
  normalizedEmail    String
  status             VerificationStatus
  riskScore          Int?
  confidenceScore    Int?
  verificationMethod String?
  reasonCode         String?
  reasonMessage      String?
  checkedAt          DateTime           @default(now())
  createdAt          DateTime           @default(now())

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       EmailVerificationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, checkedAt])
  @@index([workspaceId, status])
  @@index([jobId])
  @@index([leadId])
}

model DomainVerificationCache {
  id          String   @id @default(cuid())
  workspaceId String
  domain      String
  mxRecords   Json?
  mxFound     Boolean?
  isCatchAll  Boolean?
  isDisposable Boolean?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([expiresAt])
}

model CustomField {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String   @default("LEAD")
  key         String
  label       String
  fieldType   String   @default("TEXT")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

enum VerificationStatus {
  VERIFIED
  RISKY
  INVALID
  UNKNOWN
  DISPOSABLE
  ROLE_BASED
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#2563EB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     LeadTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model LeadTag {
  id        String   @id @default(cuid())
  leadId    String
  tagId     String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([tagId])
}

model LeadList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   LeadListMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model LeadListMember {
  id        String   @id @default(cuid())
  listId    String
  leadId    String
  createdAt DateTime @default(now())

  list LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listId, leadId])
  @@index([leadId])
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String
  workspaceId String
  authorId    String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([workspaceId])
}

// ─── Integrations ─────────────────────────────────────────────────────────────

enum IntegrationProvider {
  GOOGLE_DRIVE
}

enum IntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum ImportStatus {
  PENDING
  SCANNING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model IntegrationAccount {
  id                String              @id @default(cuid())
  workspaceId       String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(CONNECTED)
  accountEmail      String
  encryptedTokens   String
  keyVersion        Int                 @default(1)
  tokenExpiresAt    DateTime?
  lastUsedAt        DateTime?
  connectedByUserId String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadImports LeadImport[]

  @@unique([workspaceId, provider, accountEmail])
  @@index([workspaceId, provider])
}

model LeadImport {
  id                String       @id @default(cuid())
  workspaceId       String
  integrationId     String?
  source            LeadSource
  status            ImportStatus @default(PENDING)
  initiatedByUserId String
  totalFiles        Int          @default(0)
  totalRows         Int          @default(0)
  importedCount     Int          @default(0)
  skippedCount      Int          @default(0)
  duplicateCount    Int          @default(0)
  errorCount        Int          @default(0)
  columnMappings    Json         @default("{}")
  importOptions     Json         @default("{}")
  errorLog          Json         @default("[]")
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration IntegrationAccount? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  files       LeadImportFile[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model LeadImportFile {
  id                 String       @id @default(cuid())
  importId           String
  sourceFileId       String
  sourceFileName     String
  sourceFileMimeType String?
  sourceFileSize     Int?
  detectedRowCount   Int?
  detectedColumns    Json         @default("[]")
  importedRowCount   Int          @default(0)
  skippedRowCount    Int          @default(0)
  errorRowCount      Int          @default(0)
  status             ImportStatus @default(PENDING)
  errorLog           Json         @default("[]")
  createdAt          DateTime     @default(now())

  import LeadImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, sourceFileId])
  @@index([sourceFileId])
}

// ─── Large Lead Data (staging) ────────────────────────────────────────────────
// A separate staging area for very large uploads: records are cleaned,
// deduplicated and categorized here, then selectively transferred into Lead.

enum StagedLeadStatus {
  UNIQUE
  DUPLICATE
  REVIEW
  INVALID
}

model StagingDataset {
  id                String       @id @default(cuid())
  workspaceId       String
  name              String
  sourceFileName    String
  sourceFileSize    Int?
  mimeType          String?
  status            ImportStatus @default(PENDING)
  initiatedByUserId String
  totalRows         Int          @default(0)
  stagedCount       Int          @default(0)
  uniqueCount       Int          @default(0)
  duplicateCount    Int          @default(0)
  reviewCount       Int          @default(0)
  invalidCount      Int          @default(0)
  categorizedCount  Int          @default(0)
  importedCount     Int          @default(0)
  errorCount        Int          @default(0)
  columnMappings    Json         @default("{}")
  config            Json         @default("{}")
  errorLog          Json         @default("[]")
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     StagedLead[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model StagedLead {
  id          String @id @default(cuid())
  datasetId   String
  workspaceId String

  // Mapped source fields (original values preserved verbatim in rawData).
  username String?
  name     String?
  bio      String?
  category String?
  website  String?
  email    String?
  phone    String?

  // Normalized identifiers used for dedup and filtering.
  normalizedEmail    String?
  normalizedPhone    String?
  websiteDomain      String?
  normalizedUsername String?

  status      StagedLeadStatus @default(UNIQUE)
  duplicateOfId String?
  dedupReason   String?

  assignedCategory   String?
  categoryConfidence Float?
  categoryReason     String?

  rawData   Json @default("{}")
  sourceRow Int  @default(0)

  importedLeadId String?
  importedAt     DateTime?

  createdAt DateTime @default(now())

  dataset   StagingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([datasetId, status])
  @@index([datasetId, assignedCategory])
  @@index([datasetId, normalizedEmail])
  @@index([datasetId, createdAt])
  @@index([workspaceId, normalizedEmail])
}

// ─── Suppression ──────────────────────────────────────────────────────────────

model Suppression {
  id          String            @id @default(cuid())
  workspaceId String
  type        SuppressionType
  value       String
  reason      SuppressionReason
  source      String            @default("USER")
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, value])
