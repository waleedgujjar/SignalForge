model Workflow {
  id                 String         @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  status             WorkflowStatus @default(DRAFT)
  publishedVersionId String?        @unique
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishedVersion WorkflowVersion?   @relation("PublishedWorkflowVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         WorkflowVersion[]  @relation("WorkflowVersions")
  executions       WorkflowExecution[]
  activities       WorkflowActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model WorkflowVersion {
  id          String    @id @default(cuid())
  workflowId  String
  version     Int
  nodes       Json      @default("[]")
  edges       Json      @default("[]")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflow          Workflow            @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  publishedWorkflow Workflow?           @relation("PublishedWorkflowVersion")
  executions        WorkflowExecution[]

  @@unique([workflowId, version])
  @@index([workflowId])
}

model WorkflowExecution {
  id                String                  @id @default(cuid())
  workspaceId       String
  workflowId        String
  workflowVersionId String
  leadId            String
  triggerEventId    String?
  status            WorkflowExecutionStatus @default(RUNNING)
  currentNodeId     String?
  resumeAt          DateTime?
  context           Json                    @default("{}")
  stepCount         Int                     @default(0)
  startedAt         DateTime                @default(now())
  completedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workflow        Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  lead            Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  triggerEvent    WorkflowEvent?          @relation(fields: [triggerEventId], references: [id], onDelete: SetNull)
  nodeExecutions  WorkflowNodeExecution[]
  notifications   Notification[]

  @@index([workflowId, leadId, status])
  @@index([workspaceId, status])
  @@index([status, resumeAt])
  @@index([workflowId, createdAt])
}

model WorkflowNodeExecution {
  id            String                      @id @default(cuid())
  executionId   String
  nodeId        String
  nodeType      String
  status        WorkflowNodeExecutionStatus @default(PENDING)
  attempts      Int                         @default(0)
  error         String?
  errorCategory WorkflowNodeErrorCategory?
  result        Json                        @default("{}")
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId])
  @@index([executionId])
}

model WorkflowEvent {
  id             String            @id @default(cuid())
  workspaceId    String
  eventType      WorkflowEventType
  leadId         String?
  campaignId     String?
  mailboxId      String?
  conversationId String?
  idempotencyKey String
  payload        Json              @default("{}")
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, eventType, createdAt])
  @@index([processedAt])
}

model WorkflowActivity {
  id          String               @id @default(cuid())
  workflowId  String
  workspaceId String
  actorUserId String?
  type        WorkflowActivityType
  summary     String
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now())

  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([workspaceId, createdAt])
}

model Notification {
  id                  String    @id @default(cuid())
  workspaceId         String
  userId              String?
  title               String
  body                String
  href                String?
  readAt              DateTime?
  workflowExecutionId String?
  createdAt           DateTime  @default(now())

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowExecution WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, readAt])
  @@index([workspaceId, createdAt])
}

// ─────────────────────────────── Module 16 — Lead Discovery ───────────────────

enum LeadDiscoveryStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

/// Ordered pipeline position of a staged row. Each stage is advanced by an
/// idempotent worker step, so a retried job resumes rather than restarts.
enum DiscoveryStage {
  DISCOVERED
  NORMALIZED
  DEDUPLICATED
  ENRICHED
  WEBSITE_ANALYZED
  EMAIL_DISCOVERED
  EMAIL_CHECKED
  QUALIFIED
  AI_RESEARCHED
  READY
  CAMPAIGN_ENROLLED
  FAILED
}

/// Where a discovered record came from. Adapters that are not yet authorized
/// (YELP, CLUTCH, YELLOW_PAGES) exist as configuration points only — no adapter
/// implementation ships for them in V1.
enum DiscoverySourceType {
  CSV
  XLSX
  GOOGLE_PLACES
  GOOGLE_MAPS_SCRAPER
  MOCK
  MANUAL
  YELP
  CLUTCH
  YELLOW_PAGES
}

/// Provenance of an email address. PATTERN_INFERRED is a candidate, never a
/// confirmed mailbox — the UI and enrollment paths must keep the distinction.
enum EmailDiscoverySource {
  SOURCE_PROVIDED
  MAILTO
  PAGE_TEXT
  ENRICHMENT
  PATTERN_INFERRED
}

enum LeadDiscoveryActivityType {
  CREATED
  STARTED
  CANCELLED
  COMPLETED
  FAILED
  RETRIED
  LEADS_SAVED
  LEADS_EXPORTED
  LEADS_ENROLLED
  AI_RESEARCH_STARTED
  SOURCE_CONFIG_UPDATED
  REQUALIFIED
}

/// One discovery run. Counters mirror the pipeline stages so progress can be
/// polled without scanning DiscoveredLead.
model LeadDiscoveryJob {
  id                   String              @id @default(cuid())
  workspaceId          String
  initiatedByUserId    String
  source               DiscoverySourceType
  status               LeadDiscoveryStatus @default(PENDING)
  name                 String?
  query                Json                @default("{}")
  filters              Json                @default("{}")
  requestedCount       Int                 @default(0)
  discoveredCount      Int                 @default(0)
  uniqueCount          Int                 @default(0)
  duplicateCount       Int                 @default(0)
  enrichedCount        Int                 @default(0)
  websiteAnalyzedCount Int                 @default(0)
  emailsFoundCount     Int                 @default(0)
  emailsVerifiedCount  Int                 @default(0)
  qualifiedCount       Int                 @default(0)
  promotedCount        Int                 @default(0)
  failedCount          Int                 @default(0)
  error                String?
  errorLog             Json                @default("[]")
  metadata             Json                @default("{}")
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  results    DiscoveredLead[]
  activities LeadDiscoveryActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, source])
}

/// Staging row for a discovered business.
///
/// Deliberately separate from Lead: Lead.email is required and unique per
/// workspace, but most discovery sources return a business with a name, phone
/// and website and no email at all. This is a pre-flight buffer, not a second
/// lead database — rows promote into Lead once they qualify, and promotedLeadId
/// records where they landed.
model DiscoveredLead {
  id            String         @id @default(cuid())
  workspaceId   String
  jobId         String
  stage         DiscoveryStage @default(DISCOVERED)
  isDuplicate   Boolean        @default(false)
  duplicateOfId String?
  matchReason   String?

  // Raw values exactly as the source returned them.
  rawCompany String?
  rawEmail   String?
  rawPhone   String?
  rawWebsite String?

  // Canonical values produced by the normalizer; dedup only ever compares these.
  company          String?
  normalizedCompany String?
  firstName        String?
  lastName         String?
  fullName         String?
  jobTitle         String?
  email            String?
  normalizedEmail  String?
  phone            String?
  normalizedPhone  String?
  website          String?
  normalizedDomain String?
  industry         String?
  countryCode      String?
  country          String?
  state            String?
  city             String?
  postalCode       String?
  employeeCount    String?

  // Provenance for this particular record.
  source      DiscoverySourceType
  sourceId    String?
  sourceUrl   String?
  discoveredAt DateTime           @default(now())

  emailSource     EmailDiscoverySource?
  emailConfidence Int?
  emailStatus     VerificationStatus?
  emailScore      Int?

  websiteScore      Int?
  opportunityScore  Int?
  websiteAnalysis   Json?
  aiOpportunity     String?
  aiResearch        Json?

  icpFitScore   Int?
  icpBreakdown  Json?
  qualified              Boolean @default(false)
  qualifyReason          String?
  qualificationVersion   String?
  qualificationSignals   Json?

  promotedLeadId String?
  errorMessage   String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       LeadDiscoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead      Lead?            @relation(fields: [promotedLeadId], references: [id], onDelete: SetNull)

  @@index([jobId, stage])
  @@index([jobId, qualified])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, normalizedDomain])
  @@index([workspaceId, normalizedPhone])
  // One row per source record per job makes re-running a job idempotent.
  @@unique([jobId, source, sourceId])
}

/// Every source a lead has been seen in. A business found on Google, Yelp and in
/// a CSV stays ONE Lead with three rows here rather than three duplicate leads.
model LeadSourceRecord {
  id           String              @id @default(cuid())
  workspaceId  String
  leadId       String
  source       DiscoverySourceType
  sourceId     String?
  sourceUrl    String?
  jobId        String?
  discoveredAt DateTime            @default(now())
  metadata     Json                @default("{}")
  createdAt    DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Re-importing the same record must not add a second source row.
  @@unique([leadId, source, sourceId])
  @@index([workspaceId, source])
  @@index([leadId, discoveredAt])
}

model LeadDiscoveryActivity {
  id          String                    @id @default(cuid())
  jobId       String?
  workspaceId String
  actorUserId String?
  type        LeadDiscoveryActivityType
  summary     String
  metadata    Json                      @default("{}")
  createdAt   DateTime                  @default(now())

  job       LeadDiscoveryJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([workspaceId, createdAt])
}

/// Per-workspace enablement and usage counters for a discovery source.
/// Credentials are NOT stored here — provider API keys stay server-side in env.
model LeadSourceConfig {
  id                 String              @id @default(cuid())
  workspaceId        String
  source             DiscoverySourceType
  enabled            Boolean             @default(false)
  requestCount       Int                 @default(0)
  successfulRequests Int                 @default(0)
  failedRequests     Int                 @default(0)
  resultCount        Int                 @default(0)
  periodStart        DateTime            @default(now())
  lastUsedAt         DateTime?
  settings           Json                @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source])
  @@index([workspaceId, enabled])
}

// ─── Module 17 — Lead Research ────────────────────────────────────────────────

/// External platforms a lead can be researched against. LinkedIn ships first;
/// the others are declared so a later adapter needs no migration.
enum LeadResearchSource {
  LINKEDIN
  WEBSITE
  FACEBOOK
  YOUTUBE
  REDDIT
  WEB
  OTHER
}

enum LeadResearchType {
  COMPANY
  PERSON
  JOB
  OTHER
}

/// Lifecycle only. How trustworthy a value is lives in per-field provenance
/// (VERIFIED / INFERRED / UNKNOWN) and in verifiedAt, not in this enum.
enum LeadResearchStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  COMPLETED
  PARTIAL
  MANUAL_REVIEW
  FAILED
  UNAVAILABLE
}

enum ResearchConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

/// One research attempt against one external source for one lead.
///
/// Rows are append-only history: a re-run creates a new row and "latest per
/// (source, researchType)" is computed at read time. PENDING rows are
/// suggestions awaiting researcher approval (e.g. from a CSV LinkedIn column);
/// nothing runs until a human approves. structuredData holds only fields that
/// carry a provenance entry — nothing is ever fabricated. rawData is the
/// provider's trimmed response for audit and never contains credentials,
/// cookies or session material.
model LeadResearch {
  id                String              @id @default(cuid())
  workspaceId       String
  leadId            String
  source            LeadResearchSource
  researchType      LeadResearchType
  sourceUrl         String?
  normalizedUrl     String?
  status            LeadResearchStatus  @default(PENDING)
  provider          String?
  confidence        ResearchConfidence?
  summary           String?
  structuredData    Json?
  provenance        Json?
  rawData           Json?
  errorCode         String?
  errorMessage      String?
  requestedByUserId String?
  verifiedAt        DateTime?
  verifiedByUserId  String?
  inputHash         String?
  retryCount        Int                 @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activities LeadResearchActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, source, status])
  @@index([leadId, source, researchType, createdAt])
  @@index([workspaceId, createdAt])
}

/// Audit trail for research, mirroring LeadDiscoveryActivity. Holds ids, codes
/// and short messages only — never credentials or raw provider output.
model LeadResearchActivity {
  id           String             @id @default(cuid())
  workspaceId  String
  /// Null for provider-level events (health checks, toggles) that have no lead.
  leadId       String?
  researchId   String?
  source       LeadResearchSource
  provider     String?
  operation    String
  status       String
  errorCode    String?
  errorMessage String?
  actorUserId  String?
  startedAt    DateTime?
  completedAt  DateTime?
  metadata     Json               @default("{}")
  createdAt    DateTime           @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  research  LeadResearch? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([researchId, createdAt])
}

/// Per-workspace enablement, usage counters and last health result for a
/// research provider. Credentials are NOT stored here — provider keys and any
/// researcher-authenticated sessions stay outside the database entirely.
model ResearchProviderConfig {
  id                 String             @id @default(cuid())
  workspaceId        String
  source             LeadResearchSource
  provider           String
  enabled            Boolean            @default(false)
  requestCount       Int                @default(0)
  successfulRequests Int                @default(0)
  failedRequests     Int                @default(0)
  manualReviewCount  Int                @default(0)
  periodStart        DateTime           @default(now())
  lastUsedAt         DateTime?
  lastHealthCheckAt  DateTime?
  lastHealthStatus   String?
  settings           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, provider])
  @@index([workspaceId, enabled])
}
